// Prisma schema for FreeWiFi KE (VIBE Update)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  fullName       String
  email          String   @unique
  phoneNumber    String
  region         String   // Kakamega or Bungoma
  subLocation    String
  customLocation String?   // NEW: For user edited location
  address        String?   // NEW
  mapsLink       String?   // NEW
  currentPlan    String?
  renewalDate    DateTime?
  altPhone       String?   // NEW
  whatsappNumber String?   // NEW
  profileImage   String?   // NEW
  profileComplete Boolean  @default(false) // NEW
  theme          String   @default("light") // light, dark, ocean, forest
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders            Order[]
  tickets           Ticket[]
  reviews           Review[]
  userNotifications UserNotification[]
  chatMessages      ChatMessage[]
}

// Admin model
model Admin {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String   // hashed
  theme     String   @default("light")
  createdAt DateTime @default(now())

  logs              AdminLog[]
  sentNotifications SentNotification[]
}

// Admin Activity Log (NEW)
model AdminLog {
  id          String   @id @default(cuid())
  adminId     String?  // Can be null if it's a system action or superadmin
  admin       Admin?   @relation(fields: [adminId], references: [id])
  action      String   // login, logout, order_update, ticket_response
  entityType  String?  // order, ticket, user, review, chat
  entityId    String?
  details     String   @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// System Notification (for Admin) (NEW)
model SystemNotification {
  id          String   @id @default(cuid())
  type        String   // order, ticket, chat, user, review
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// User Notification (for User) (NEW)
model UserNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  message     String
  type        String   // system, admin_sent, order_update, ticket_update
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Sent Notification Logs (Bulk/Individual) (NEW)
model SentNotification {
  id          String   @id @default(cuid())
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id])
  type        String   // bulk, individual
  subject     String
  message     String   @db.Text
  recipients  String   @db.Text // JSON
  sentCount   Int
  createdAt   DateTime @default(now())
}

// Password Reset Token (NEW)
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Order model
model Order {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  plan           String
  price          Int
  region         String
  subLocation    String
  address        String
  mapsLink       String?
  preferredDate  DateTime
  whatsappNumber String
  notes          String?
  status         String   @default("pending")
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Support Ticket model
model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  problemType String
  description String
  urgency     String
  status      String   @default("open")
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Review model
model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int
  content     String?
  region      String
  subLocation String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// AI Chat Message model
model ChatMessage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  role         String   // "user", "assistant", "admin"
  content      String   @db.Text
  mentionAdmin Boolean  @default(false)
  isRead       Boolean  @default(false)
  adminRead    Boolean  @default(false)    // NEW
  adminStatus  String   @default("new")    // NEW: new, pending, resolved
  adminReply   String?                     // NEW
  adminReplyAt DateTime?                   // NEW
  createdAt    DateTime @default(now())
}

// Legacy Notification model (Keeping for safety, but VIBE uses System/User/SentNotification)
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  userId    String?
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Message Templates for WhatsApp (NEW)
model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  category  String   // inquiry, installation, support, payment
  createdBy String   // Admin ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
