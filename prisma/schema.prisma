// Prisma schema for FreeWiFi KE (from prompt.txt)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id             String   @id @default(cuid())
  clerkId        String   @unique
  fullName       String
  email          String   @unique
  phoneNumber    String
  region         String   // Kakamega or Bungoma
  subLocation    String
  currentPlan    String?
  renewalDate    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders       Order[]
  tickets      Ticket[]
  reviews      Review[]
}

// Admin model
model Admin {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String   // hashed
  createdAt DateTime @default(now())
}

// Order model
model Order {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  plan           String   // "10mbps" or "12mbps"
  price          Int      // 1500 or 2000
  region         String
  subLocation    String
  address        String
  mapsLink       String?
  preferredDate  DateTime
  whatsappNumber String
  notes          String?
  status         String   @default("pending") // pending, in_progress, completed, cancelled
  adminNotes     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Support Ticket model
model Ticket {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  problemType String
  description String
  urgency     String   // low, medium, high
  status      String   @default("open") // open, in_progress, resolved
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Review model
model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rating      Int      // 1-5
  content     String?
  region      String
  subLocation String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// AI Chat Message model
model ChatMessage {
  id           String   @id @default(cuid())
  userId       String   // Clerk user ID (no foreign key)
  role         String   // "user" or "assistant"
  content      String   @db.Text
  mentionAdmin Boolean  @default(false)
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Notification model
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, success, warning, alert
  userId    String?  // Optional: if null, it's a global notification
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
}
